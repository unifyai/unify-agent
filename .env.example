# Copy this file to `.env`, or export the variables. Everything the agent keeps
# lives under UNIFY_HOME (default ~/.unify); the only credential it needs is one
# LLM provider key. CONFIG.md lists every variable the package reads.

# At least one LLM provider key is required. Every model but Anthropic's is
# reached through OpenRouter, so OPENROUTER_API_KEY covers OpenAI, DeepSeek and
# the default model.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# The default model (a unillm `model@provider` endpoint) and reasoning effort.
# UNIFY_MODEL="openai/gpt-5.6-sol@openrouter"
# UNIFY_REASONING_EFFORT=high
# The endpoints cell code may name in query_llm / unillm: empty = only the
# session's model, "any" = every endpoint, or a comma list added to it.
# UNIFY_CELL_LLM_MODELS=

# Memory: on (the default) or off (no memory of any kind).
# UNIFY_MEMORY=on

# Where the workspace, transcripts, memory, the embeddings cache and the logs
# live.
# UNIFY_HOME=~/.unify

# Embeddings for memory's search are never requested from a provider directly.
# Either compute them in process with BAAI/bge-small-en-v1.5 (install the
# local-embeddings extra; a one-time 134 MB download, then offline, English
# only), or post OpenRouter-style requests to a proxy lane on the loopback
# address that holds the key.
# UNIFY_LOCAL_EMBEDDINGS=false
# UNIFY_EMBED_URL=http://127.0.0.1:<port>/v1/embeddings

# The environment's own callable surface as primitives.<name> namespaces:
# comma-separated package.module:factory entries.
# UNIFY_ENV_NAMESPACES=
# proxy: the sandbox reaches only the proxy on 127.0.0.1:<port> of the host.
# UNIFY_WORKSPACE_NETWORK=
# UNIFY_WORKSPACE_PROXY_PORT=
# A runner's own variables a cell gets from the harness's environment, beside
# the built-in allow-list: a comma list of names and PREFIX_* patterns.
# UNIFY_CELL_ENV_ALLOW=
