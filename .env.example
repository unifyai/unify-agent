# Copy this file to `.env`, or export the variables. Everything the assistant
# remembers lives under UNIFY_HOME (default ~/.unify); the only credential it
# needs is one LLM key. On a machine that holds the unify team's
# service-account key (~/.config/gcloud/automation.json) the keys come from
# Google Secret Manager through unillm, so no .env is needed there.

# At least one LLM provider key is required. Every model but Anthropic's is
# reached through OpenRouter, so OPENROUTER_API_KEY covers OpenAI, DeepSeek and
# the default model.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# The default model (a unillm `model@provider` endpoint) and reasoning effort.
# UNIFY_MODEL="openai/gpt-5.6-sol@openrouter"
# UNIFY_REASONING_EFFORT=high

# Where the store, the embeddings cache, the workspace and logs live.
# UNIFY_HOME=~/.unify
# An explicit path for the SQLite store, overriding <UNIFY_HOME>/store.sqlite.
# UNIFY_STORE_PATH=
# An explicit path for the embeddings cache, overriding
# <UNIFY_HOME>/embeddings.sqlite.
# UNIFY_EMBED_CACHE=

# Skill search embeds text with openai/text-embedding-3-small through
# OpenRouter. Set true to embed in process with BAAI/bge-small-en-v1.5 instead:
# a one-time 134 MB download, then offline, but English only.
# UNIFY_LOCAL_EMBEDDINGS=false

# The environment's own callable surface as primitives.<name> namespaces:
# comma-separated package.module:factory entries (see
# unify/function_manager/primitives/environment.py).
# UNIFY_ENV_NAMESPACES=

# Cache LLM responses locally. First run hits the provider; later runs replay.
UNILLM_CACHE=true

# Validate that an LLM provider key is present on startup.
UNIFY_VALIDATE_LLM_PROVIDERS=true

# Optional identity for the assistant and its user, shown in prompts and
# stored on their contact records.
# ASSISTANT_FIRST_NAME=Unity
# ASSISTANT_TIMEZONE=Europe/London
# USER_FIRST_NAME=
# USER_SURNAME=
# USER_EMAIL=
