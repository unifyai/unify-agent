# Copy this file to `.env`, or export the variables. Everything the assistant
# remembers lives under UNIFY_HOME (default ~/.unify); the only credential it
# needs is one LLM key. On a machine that holds the unify team's
# service-account key (~/.config/gcloud/automation.json) the keys come from
# Google Secret Manager through unillm, so no .env is needed there.

# At least one LLM provider key is required. Every model but Anthropic's is
# reached through OpenRouter, so OPENROUTER_API_KEY covers OpenAI, DeepSeek and
# the default model.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# The default model (a unillm `model@provider` endpoint) and reasoning effort.
# UNIFY_MODEL="openai/gpt-5.6-sol@openrouter"
# UNIFY_REASONING_EFFORT=high

# Where the store, the embeddings cache, the workspace and logs live.
# UNIFY_HOME=~/.unify
# An explicit path for the SQLite store, overriding <UNIFY_HOME>/store.sqlite.
# UNIFY_STORE_PATH=
# An explicit path for the embeddings cache, overriding
# <UNIFY_HOME>/embeddings.sqlite.
# UNIFY_EMBED_CACHE=

# Skill search embeds text with openai/text-embedding-3-small through
# OpenRouter. Set true to embed in process with BAAI/bge-small-en-v1.5 instead:
# a one-time 134 MB download, then offline, but English only.
# UNIFY_LOCAL_EMBEDDINGS=false
# Post the OpenRouter embedding requests to another endpoint (for example a
# proxy that tracks their cost).
# UNIFY_EMBED_URL=

# The environment's own callable surface as primitives.<name> namespaces:
# comma-separated package.module:factory entries (see
# unify/function_manager/primitives/environment.py).
# UNIFY_ENV_NAMESPACES=
# resolve: refuse to store a function whose names do not resolve or that does
# not load, saying why.
# UNIFY_STORE_CHECK=
# Leave an unloadable stored function out of search results, with a warning,
# instead of failing the whole result.
# UNIFY_SEARCH_SKIP_UNLOADABLE=false
# A JSON file in which an external check of the session's outcome admits
# ({"admit": true}) the review run when the session ends; otherwise it is
# skipped. While set, the session itself cannot write to the libraries.
# never: a frozen library -- writes withheld, no review ever admitted.
# UNIFY_STORE_ADMISSION=
# A package.module:factory verifier: a function is stored only after it has
# passed a run on a held-out task and the static checks (needs
# UNIFY_STORE_ADMISSION; see unify/function_manager/store_verify.py).
# UNIFY_STORE_VERIFY=
# Retry a forced tool choice that the provider refuses for this model (HTTP 400)
# as "auto" plus an instruction to make the required call first, and use that
# for the model's later forced calls in the process.
# UNIFY_TOOL_CHOICE_FALLBACK=false
# stored: a guidance search with no reference text returns the stored guidance,
# newest first, instead of the built-in catalogue.
# UNIFY_GUIDANCE_EMPTY_QUERY=
# on: offer patch tools that replace one exact excerpt of a stored function or
# guidance entry in place, and keep every overwritten version in history.
# UNIFY_FUNCTION_PATCH=false
# warn: adding a function nearly identical to a stored one (normalised code
# token Jaccard >= 0.9) stores it with a warning naming the stored function.
# UNIFY_STORE_DEDUPE=
# ramp: record every reuse of a stored function; one that raises is quarantined
# (hidden from loaded searches, listed to the next storage review for repair),
# one that passes 3 times over 2 inputs (5 over 3 if it changes anything) is
# trusted, and a code change restarts probation. With UNIFY_STORE_VERIFY set, a
# reuse is re-checked in a fresh world with probability 1/2^(clean uses).
# UNIFY_STORE_TRUST=
# on: keep each tool loop's requests a byte-stable, growing prefix so the
# provider's prompt cache is reused -- one tool list per session (tools a phase
# does not allow are refused, not removed), sent messages never edited,
# compression as a fork of the conversation, a cache affinity key, and a
# cache-hit line per call in the logs.
# UNIFY_CACHE_DISCIPLINE=false
# Who shares the cache affinity key: prefix (sessions with the same model,
# system prompt and tool list), session (one key each) or run (this process).
# UNIFY_CACHE_AFFINITY_SCOPE=prefix
# on: run the post-session storage review as a fork of the session's own
# conversation (same system prompt, messages and tools, plus one message with
# the review rulebook), so it reuses the session's prompt cache. Needs
# UNIFY_CACHE_DISCIPLINE; otherwise, or after compression, the review runs as
# shipped. A message sent to a persistent session after its task loop ended is
# refused rather than read by the review.
# UNIFY_REVIEW_FORK=false
# on: take the session's checked outcome from the environment (an
# {"outcome": {...}} line on the stdin of `unify act --jsonl`, or
# unify.outcome.post), held in memory; the storage review reads it as the
# checker's verdict, and its final result is the agent's last reply before it.
# UNIFY_OUTCOME=false
# lessons: review a failed run (outcome solved false, or an admission verdict of
# {"admit": "lessons"}) with function writes refused and guidance allowed.
# UNIFY_REVIEW_FAILED=

# Append every agent conversation to <UNIFY_HOME>/transcripts/<session>.jsonl
# (never rewritten) plus one line per session to transcripts/index.jsonl; the
# context left after a compression points the model at the file.
# UNIFY_TRANSCRIPTS=false

# sandboxed: execute_code also runs bash (a persistent session), the actor gets
# read_file and grep, and bash cells and the subprocesses of Python cells run
# in bubblewrap -- only the workspace and /tmp writable, Unify's state,
# credentials and .env files hidden, no network. Needs bwrap (Linux).
# UNIFY_WORKSPACE=
# proxy: the sandbox reaches only the proxy on 127.0.0.1:<port> of the host.
# UNIFY_WORKSPACE_NETWORK=
# UNIFY_WORKSPACE_PROXY_PORT=
# worker (with sandboxed): Python cells run in a child process inside the same
# sandbox and reach primitives only through a proxy served by the harness.
# UNIFY_WORKSPACE_PYTHON=

# Cache LLM responses locally. First run hits the provider; later runs replay.
UNILLM_CACHE=true

# Validate that an LLM provider key is present on startup.
UNIFY_VALIDATE_LLM_PROVIDERS=true

# Optional identity for the assistant and its user, shown in prompts and
# stored on their contact records.
# ASSISTANT_FIRST_NAME=Unity
# ASSISTANT_TIMEZONE=Europe/London
# USER_FIRST_NAME=
# USER_SURNAME=
# USER_EMAIL=
